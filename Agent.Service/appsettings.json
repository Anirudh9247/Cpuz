{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AgentConfig": {
    "AgentId": "COMPUTER-DOCTOR-AGENT-01",
    "MachineName": "LOCAL-SYSTEM",
    "ServerWebSocketUrl": "ws://localhost:8080/ws",
    "WebSocketPort": 8080,
    "UdpDiscoveryPort": 8888,
    "EnableUdpDiscovery": true,
    "FastCollectionIntervalMs": 2000,
    "SlowCollectionIntervalMs": 30000,
    "MetricCollectionIntervalMs": 2000,
    "TopProcessCount": 10,
    "EnableHardwareMonitoring": true,
    "EnableProcessMonitoring": true,
    "EnableStorageMonitoring": true,
    "CpuWarningTempC": 75.0,
    "CpuCriticalTempC": 85.0,
    "GpuWarningTempC": 78.0,
    "GpuCriticalTempC": 85.0,
    "RamWarningPercent": 80.0,
    "RamCriticalPercent": 90.0,
    "SsdWarningHealthPercent": 85,
    "SsdCriticalHealthPercent": 70
  }
}
